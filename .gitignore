# Credentials — must never be committed. A leaked token is the one mistake on
# this project that cannot be undone: public repos are scanned by bots within
# minutes, and git keeps the value in history forever.
.jobs-config
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Enumeration cache and raw snapshots. Large, regenerable, and raw postings
# should not be republished. Discovery lists remain versioned for reproducible
# offline operation; HTTP recordings remain private.
.cache/*
raw/
!engine/data/raw/
engine/data/raw/*
!engine/data/raw/README.md
!engine/data/raw/discovery-cache/
engine/data/raw/discovery-cache/*
!engine/data/raw/discovery-cache/boards_*.json
!engine/data/raw/discovery-cache/crawl_id.txt

# ...but DO track the enumerated board lists. They are the expensive artifact:
# Common Crawl throttles hard, so re-querying on every CI run is both rude and
# unreliable. Versioning them also makes a sweep reproducible.
!.cache/boards_*.json
!.cache/crawl_id.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local scratch
*.log
*.tmp
jobs.json.tmp
# Generated lake artifacts. Large and regenerable; operational backups remain
# ignored by the generic *.bak rule.
engine/data/measure/keka_raw.json
*.bak

# Canonical data lake now lives in S3 (s3://$AWS_S3_BUCKET/lake/), not git.
# These are large and are seeded/synced by the sweep workflow. Kept on disk
# locally and in CI, but never committed. See AGENTS.md / README.md.
engine/data/lake/opportunities.json
engine/data/lake/hidden.json
engine/data/lake/opportunities_history.json