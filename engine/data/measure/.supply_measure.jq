def early: test("\\b(intern|interns|internship|trainee|traineeship|fresher|freshers|apprentice|apprenticeship|graduate[[:space:]]+engineer|graduate[[:space:]]+trainee|graduate[[:space:]]+programme|graduate[[:space:]]+program|graduate[[:space:]]+scheme|campus|new[[:space:]]+grad|new[[:space:]]+graduate|entry[[:space:]-]?level|early[[:space:]]+career|placement[[:space:]]+year|industrial[[:space:]]+placement|emerging[[:space:]]+talent|explore[[:space:]]+program|praktikum|praktikant|werkstudent|absolvent|stagiaire|alternance|新卒|インターン)\\b"; "i");
def earlylevel: test("(?:\\b(?:associate|junior|jr\\.?|trainee)\\b|\\b(?:sde|swe)[[:space:]]*-?[[:space:]]*(?:1|i)\\b|\\b(?:software[[:space:]]+development[[:space:]]+engineer|engineer|analyst)[[:space:]]*(?:-?[[:space:]]*1|i)\\b|\\bl1\\b|\\blevel[[:space:]]*[- ]?1\\b)"; "i");
def senior: test("\\b(?:senior|sr\\.?|principal|lead|leader|head|manager|mgr|director|architect|vp|vice[[:space:]]+president|chief|cto|ceo|cfo|coo|staff[[:space:]]+(?:software[[:space:]]+)?(?:engineer|sde|scientist|developer|full[[:space:]-]?stack|architect|researcher)\\b|(?:sde|swe|software[[:space:]]+development[[:space:]]+engineer|engineer|analyst)[[:space:]]*[- ]?[[:space:]]*(?:ii|iii|iv|2|3|4)\\b|level[[:space:]]*[- ]?[[:space:]]*(?:ii|iii|iv|2|3|4|5)\\b|l[2-4]\\b|(?:5|[6-9]|[0-9]{2,})[[:space:]]*\\+[[:space:]]*years?\\b|(?:4|5|[6-9]|[0-9]{2,})[[:space:]]+(?:to|-)[[:space:]]+[[:digit:]]{1,2}[[:space:]]+years?\\b|(?:5|[6-9]|[0-9]{2,})[[:space:]]+years?\\b)\\b"; "i");
def override: test("\\b(intern|trainee|apprentice)\\b"; "i");
def stage: if test("\\bmembers?[[:space:]]+of[[:space:]]+technical[[:space:]]+staff\\b";"i") then (if early or earlylevel then "early" else "unknown" end) elif senior then (if override then "early" else "senior" end) elif early or earlylevel then "early" else "unknown" end;
def strong_nontech: test("\\b(recruit[[:alnum:]_]*|recruiter|talent[[:space:]]+acquisition|staffing|sourcer|trainer|training[[:space:]]+operations|sales|telecall[[:alnum:]_]*|telecalling|sdr|bdr|lead[[:space:]]+generation|business[[:space:]]+development|go[ -]?to[ -]?market|gtm|account[[:space:]]+executive|account[[:space:]]+manager|accountant|accounting|book[[:space:]]?keep[[:alnum:]_]*|taxation|treasury|payroll|kyc|aml|anti[ -]?money|money[[:space:]]+laundering|financial[[:space:]]+crime|litigation|counsel|paralegal|company[[:space:]]+secretary|icwa|actuar[[:alnum:]_]*|underwrit[[:alnum:]_]*|chef|sommelier|culinary|butcher|fishmonger|barista|waiter|plumb[[:alnum:]_]*|electrician|hvac|welder|fitter|woodworker|carpenter|mechanic|automotive|installer|technician[ -]?install|warehouse|forklift|nurse|nursing|physiotherap[[:alnum:]_]*|pharmac[[:alnum:]_]*|dental|dentist|echocardiograph[[:alnum:]_]*|therapist|radiograph[[:alnum:]_]*|phlebotom[[:alnum:]_]*|behavio(u)?r[[:space:]]+technician|teacher|teaching|preschool|curriculum|ministry|casework|social[[:space:]]+work|counsellor|counselor|nutrition[[:alnum:]_]*|horticultur[[:alnum:]_]*|landscap[[:alnum:]_]*|agronom[[:alnum:]_]*|gardener|facilities|animator|animation|motion[[:space:]]+design[[:alnum:]_]*|fx[[:space:]]+artist|cfx|vfx|concept[[:space:]]+artist|videograph[[:alnum:]_]*|photograph[[:alnum:]_]*|copywriter|executive[[:space:]]+assistant|personal[[:space:]]+assistant|receptionist|housekeep[[:alnum:]_]*|guest[[:space:]]+(?:operations|relations)|front[[:space:]]+office|travel[[:space:]]+consultant|customer[[:space:]]+(?:service|care)|data[[:space:]]+entry|mis\\b)";"i");
def technical: test("\\b(software|developer|develop[[:alnum:]_]*|dev|engineer|engineering|sde|swe|programm[[:alnum:]_]*|programmer|technical|backend|back[ -]?end|frontend|front[ -]?end|full[ -]?stack|data|database|analytics|analytic|analyst|ml|machine[[:space:]]+learning|ai|artificial[[:space:]]+intelligence|deep[[:space:]]+learning|nlp|computer[[:space:]]+vision|llm|generative|devops|sre|site[[:space:]]+reliability|platform|infrastructure|cloud|qa|quality[[:space:]]+assurance|quality[[:space:]]+and[[:space:]]+testing|sdet|test[[:alnum:]_]*|automation|automat[[:alnum:]_]*|android|ios|mobile|web|python|java|golang|rust|react|node|salesforce|oracle|sap|security|cyber|network[[:alnum:]_]*|embedded|firmware|hardware|vlsi|compiler|systems|system[[:space:]]+admin[[:alnum:]_]*|robotics|research|cad|cae|mechatronic[[:alnum:]_]*|electrical|electronic[[:alnum:]_]*|instrumentation|scrum|sysadmin|technology)\\b";"i");
def nontech: test("\\b(hr|human[[:space:]]+resource|payroll|inside[[:space:]]+sales|bd|marketing|seo|smm|social[[:space:]]+media|influencer|brand|content|copy[[:space:]]+writer|writer|editor|blog|video|graphic|design|photoshop|illustrator|finance|financial|accounts|audit|billing|procurement|supply[[:space:]]+chain|logistics|customer[[:space:]]+support|customer[[:space:]]+success|customer[[:space:]]+experience|operations[[:space:]]+executive|merchant[[:space:]]+operations|legal|admin|office|reception|communication|public[[:space:]]+relations|pr|event[[:space:]]+management|fundraising|investor[[:space:]]+relations|monitoring[[:space:]]*&[[:space:]]*evaluation|partnership|strategy|consulting|m&a|apprenticeship[[:space:]]+for[[:space:]]+military[[:space:]]+veterans)\\b";"i");
def tech: if strong_nontech then false elif technical then true elif nontech then false else null end;
def india: test("\\b(india|bengaluru|bangalore|hyderabad|pune|delhi|new[[:space:]]+delhi|ncr|noida|gurugram|gurgaon|mumbai|navi[[:space:]]+mumbai|thane|chennai|kolkata|ahmedabad|kochi|cochin|indore|jaipur|coimbatore|lucknow|chandigarh|mohali|bhubaneswar|nagpur|surat|vadodara|thiruvananthapuram|trivandrum|mysore|mysuru|nashik|visakhapatnam|mangaluru|mangalore|bhopal|kanpur|patna|guwahati|dehradun|goa|vellore|madurai|trichy|karnataka|maharashtra|telangana|tamil[[:space:]]+nadu|gujarat|kerala|haryana|uttar[[:space:]]+pradesh|rajasthan|west[[:space:]]+bengal|punjab)\\b";"i") or test("\\b(worldwide|world[[:space:]]?wide|global(?:ly)?[[:space:]]*remote|remote[ -–,]?global|work[[:space:]]+from[[:space:]]+anywhere|anywhere|any[[:space:]]+location|fully[[:space:]]+remote|remote[[:space:]]*\\(global\\))\\b";"i");
def oldearly: test("\\b(intern|interns|internship|trainee|traineeship|fresher|freshers|apprentice|apprenticeship|graduate[[:space:]]+engineer|graduate[[:space:]]+trainee|graduate[[:space:]]+programme|graduate[[:space:]]+program|graduate[[:space:]]+scheme|campus|new[[:space:]]+grad|new[[:space:]]+graduate|entry[[:space:]-]?level|early[[:space:]]+career|placement[[:space:]]+year|industrial[[:space:]]+placement|emerging[[:space:]]+talent|explore[[:space:]]+program|praktikum|praktikant|werkstudent|absolvent|stagiaire|alternance|新卒|インターン)\\b";"i");
map({title:(.title//""), loc:(.location//""), platform:(.platform//""), description:(.description//"")} | .stage=(.title|stage) | .tech=(.title|tech) | .india=(.loc|india) | .old=(.title|oldearly))
